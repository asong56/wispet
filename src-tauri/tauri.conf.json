{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Wispet",
  "version": "0.1.0",
  "identifier": "Wispet",
  "build": {
    "frontendDist": "../src",
    "devUrl": null,
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost https://ipc.localhost; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost https://asset.localhost data: wispet:; media-src 'self' wispet:"
    },
    "windows": [
      {
        "label": "main",
        "title": "Wispet",
        "url": "index.html",
        "width": 560,
        "height": 68,
        "minWidth": 560,
        "minHeight": 68,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "center": true,
        "resizable": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "visible": false,
        "focus": true
      }
    ],
    "trayIcon": {
      "iconPath": "icons/tray.png",
      "iconAsTemplate": true,
      "showMenuOnLeftClick": false
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": [],
    "externalBin": [],
    "copyright": "",
    "category": "Utility",
    "shortDescription": "Lightweight dictionary & translation",
    "longDescription": "Wispet is a minimal, fast dictionary and translation tool with system tray integration and selection-to-translate support."
  }
}
