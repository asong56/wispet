{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Wispet",
  "version": "0.1.0",
  "identifier": "app.wispet",
  "build": {
    "frontendDist": "../src",
    "devUrl": null,
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": null
    },
    "windows": [
      {
        "label": "main",
        "title": "Wispet",
        "url": "index.html",
        "width": 680,
        "height": 520,
        "minWidth": 480,
        "minHeight": 360,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "center": true,
        "resizable": true,
        "skipTaskbar": true,
        "alwaysOnTop": false,
        "visible": false,
        "focus": true
      }
    ],
    "trayIcon": {
      "iconPath": "icons/tray.png",
      "iconAsTemplate": true,
      "menuOnLeftClick": false
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [],
    "externalBin": [],
    "copyright": "",
    "category": "Utility",
    "shortDescription": "Lightweight dictionary & translation",
    "longDescription": "Wispet is a minimal, fast dictionary and translation tool with system tray integration and selection-to-translate support."
  }
}
