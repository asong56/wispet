{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Core, dialog, and window permissions for the main and popup windows.",
  "windows": ["main", "popup"],
  "permissions": [
    "core:default",
    "core:window:allow-hide",
    "core:event:allow-emit",
    "core:event:allow-listen",
    "dialog:default",
    "dialog:allow-open"
  ]
}
